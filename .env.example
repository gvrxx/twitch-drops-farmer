# Copy to .env and fill in.

# Password for the browser view on port 6080 (only the first 8 characters are used).
VNC_PASSWORD=

# Your timezone, for log timestamps.
TZ=Europe/London

# Hostnames you use to open the dashboard, comma-separated. IP addresses always work.
ALLOWED_HOSTS=tower,tower.local

# Where the login, settings and browser profile are stored on the server.
DATA_PATH=/mnt/user/appdata/twitch-drops-farmer
